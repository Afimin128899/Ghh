# Telegram API credentials: https://my.telegram.org
API_ID=123456
API_HASH=replace_with_your_api_hash
BOT_TOKEN=123456:replace_with_your_bot_token

# Comma-separated Telegram user IDs. The bot denies everybody else.
ADMIN_IDS=123456789

SESSION_TIMEOUT_MINUTES=15
MAX_QUEUE_PER_USER=250
MAX_UPLOAD_BYTES=52428800
MAX_ARCHIVE_MEMBERS=500
MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
DEFAULT_AUTO_CODE=1
CONCURRENT_WORKERS_PER_CHAT=2
DB_FILE=sessions_v100x.db
UPLOAD_DIR=uploads
QUARANTINE_DIR=quarantine

# Custom emoji icons and colored inline buttons (Bot API 9.4+).
# The bot owner's Telegram account must have Premium. Set false for Unicode fallback.
ENABLE_CUSTOM_BUTTON_EMOJI=true
# Optional comma-separated replacements: cancel=123...,new=456...
CUSTOM_BUTTON_EMOJI_OVERRIDES=

# Optional referral automations are deliberately disabled by default.
ENABLE_UGS_REFERRAL=false
UGS_BOT_USERNAME=GameUGSbot
UGS_REF_PARAM=

ENABLE_RC_REFERRAL=false
RC_BOT_USERNAME=redcubebetbot
RC_START_PARAM=
RC_CHANNEL_1=rcbet
RC_CHANNEL_2=rc_chat

# Optional fallback proxy.
PROXY_PROTOCOL=
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
